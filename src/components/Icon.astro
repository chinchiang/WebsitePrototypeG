---
/**
 * 架構先行、內容後補
 * 單色線性圖示，禁止使用 emoji。
 */
type Name =
  | "shield"
  | "home"
  | "file"
  | "book"
  | "alert"
  | "tool"
  | "user"
  | "org"
  | "search"
  | "menu"
  | "close"
  | "chevron"
  | "external"
  | "check"
  | "flow";

interface Props {
  name: Name;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = "" } = Astro.props;

const paths: Record<Name, string> = {
  shield:
    "M12 3 5 6v5c0 4.4 2.9 8.4 7 9.5 4.1-1.1 7-5.1 7-9.5V6l-7-3Z M12 11v6 M9 13.5h6",
  home: "M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-8Z",
  file: "M7 4h7l4 4v12H7V4Z M14 4v4h4 M9 13h6 M9 17h4",
  book: "M5 5h6a3 3 0 0 1 3 3v11H8a3 3 0 0 0-3 3V5Z M13 8h6v14a3 3 0 0 0-3-3h-3",
  alert: "M12 4 3 20h18L12 4Z M12 10v5 M12 17.5v.5",
  tool: "M14.5 4.5a4 4 0 0 0-5.6 5.6L4 15v5h5l4.9-4.9A4 4 0 0 0 14.5 4.5Z M16 8l3 3",
  user: "M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z M5 20a7 7 0 0 1 14 0",
  org: "M8 6h8v5H8V6Z M3 15h6v5H3v-5Z M15 15h6v5h-6v-5Z M12 11v4 M6 15v-2h12v2",
  search: "M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z M20 20l-3.5-3.5",
  menu: "M4 7h16 M4 12h16 M4 17h16",
  close: "M6 6l12 12 M18 6 6 18",
  chevron: "M9 6l6 6-6 6",
  external: "M10 6h8v8 M18 6l-9 9 M6 10v8h8",
  check: "M5 12.5 9.5 17 19 7",
  flow: "M6 7h4v4H6V7Z M14 13h4v4h-4v-4Z M10 9h4 M16 13V9h-2",
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
